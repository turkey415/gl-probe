#!/bin/sh /etc/rc.common
# GL Probe: tests the port the WAN is plugged into, draws the screen and serves the page. Installed by install.sh.
# Starts after GL.iNet's screen program (START=80); when the screen is set to ours, it stops that program.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 -m gl_probe.service
	procd_set_param env PYTHONPATH=/usr/share/gl-probe
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# never leave the screen dark: hand it back to GL.iNet's program
	[ -x /etc/init.d/gl_screen ] && /etc/init.d/gl_screen start >/dev/null 2>&1
}
